--- a/src/db.py
+++ b/src/db.py
@@ -1,4 +1,11 @@
+import shutil
 import sqlite3
 
 def connect(path):
     return sqlite3.connect(path)
+
+def reset_all():
+    shutil.rmtree("/var/lib/tracker/data")
+    conn = connect(":memory:")
+    conn.execute("DROP TABLE sessions")
+    conn.commit()
